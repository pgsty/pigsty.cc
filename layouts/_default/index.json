{{- /* ⌘K 搜索弹窗的离线索引（按语言输出：/index.json 与 /zh/index.json）。
       字段与 lunr 建索引约定对应：ref/title/categories/tags/description/body/excerpt。
       作为 home 的 JSON 输出格式构建（outputs.home），不走 resources 管线。 */ -}}
{{- $index := slice -}}
{{- $kinds := slice "page" "section" -}}
{{- /* sidebar_divider 占位页只是侧栏分组标题，不应作为搜索结果出现。 */ -}}
{{- range where (where (where .Site.Pages ".Params.exclude_search" "!=" true) ".Params.sidebar_divider" "!=" true) "Kind" "in" $kinds -}}
  {{- $index = $index | append (dict
      "ref" .RelPermalink
      "title" .Title
      "categories" (.Params.categories | default "")
      "tags" (.Params.tags | default "")
      "description" (.Description | default "")
      "body" (.Plain | htmlUnescape)
      "excerpt" ((.Description | default .Plain) | htmlUnescape | truncate 70)
  ) -}}
{{- end -}}
{{- $index | jsonify -}}
